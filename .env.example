# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor: convites de equipe e lembretes automáticos
SUPABASE_SERVICE_ROLE_KEY=

# Leitura das contas: use UM dos dois (OpenRouter tem prioridade se preenchido)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# WhatsApp (Evolution API da VisioPro); a instância fica no cadastro de cada usina
EVOLUTION_API_URL=https://evolution.seudominio.com.br
EVOLUTION_API_KEY=

# Protege a rota do cron de lembretes (a Vercel envia como Bearer)
CRON_SECRET=

# URL pública do app (links nos convites)
NEXT_PUBLIC_APP_URL=https://solar.visiopro.app.br
